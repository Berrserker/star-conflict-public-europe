# Game, databases and backups: huge, and contain player data (passwords, IPs)
game/
server/
db/
backups/

# Build/tool output and temporary stuff
sc-vps.zip
.wrangler/
node_modules/
diag/
_update_*/
deploy/stats/geo/*.csv

# Packet captures and dumps contain player IPs
*.etl
