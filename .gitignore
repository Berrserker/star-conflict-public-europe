start_game.bat
start_server_only.bat

# Superseded modified kit files kept on the VPS only
deploy/files/**/*.old

# Local-only restart helper
restart_local_server.ps1

# Status push token copied from the VPS (secret)
status_push.token

# Player logs / archives (contain player IPs)
*.zip
